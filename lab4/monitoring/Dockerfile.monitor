FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
COPY requirements-monitor.txt /tmp/requirements-monitor.txt
RUN pip install --index-url https://pypi.org/simple --require-hashes -r /tmp/requirements-monitor.txt
RUN useradd --create-home --uid 10001 runner
USER runner
WORKDIR /work
